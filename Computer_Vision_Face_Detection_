    "id": "aSJS8wWgP1sw"
   },
   "outputs": [],
   "source": [
    "full_detector = load_cascade(DATA_DIR / \"Cascades/fullbody.xml\")\n",
    "image = load_image(DATA_DIR / \"Images/people3.jpg\")\n",
    "image_gray = cv2.cvtColor(image, cv2.COLOR_BGR2GRAY)\n",
    "detections = full_detector.detectMultiScale(image_gray, scaleFactor = 1.5, minNeighbors=5,\n",
    "                                              minSize = (50,50))\n",
    "for (x, y, w, h) in detections:\n",
    "  cv2.rectangle(image, (x, y), (x + w, y + h), (0,255,0), 2)\n",
    "cv2_imshow(image)"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {
    "id": "Vw1aTLB6SdP2"
   },
   "source": [
    "## Dlib"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {
    "id": "CPX-q-Gl8OxW"
   },
   "outputs": [],
   "source": [
    "try:\n",
    "    import dlib\n",
    "    DLIB_AVAILABLE = True\n",
    "except ImportError:\n",
    "    dlib = None\n",
    "    DLIB_AVAILABLE = False\n",
    "    print(\"dlib is not installed. HOG and CNN sections will be skipped.\")\n"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {
    "id": "Z6Dh_9PRmRrV"
   },
   "source": [
    "### Detecting faces with HOG"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {
    "id": "Re7qxFbs8XjH"
   },
   "outputs": [],
   "source": [
    "if DLIB_AVAILABLE:\n",
    "    image = load_image(DATA_DIR / \"Images/people2.jpg\")\n",
    "    cv2_imshow(image)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {
    "id": "EYa1sRn38ylv"
   },
   "outputs": [],
   "source": [
    "if DLIB_AVAILABLE:\n",
    "    face_detector_hog = dlib.get_frontal_face_detector()"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {
    "id": "wfcS_n2p87WI"
   },
   "outputs": [],
   "source": [
    "if DLIB_AVAILABLE:\n",
    "    detections = face_detector_hog(image, 1)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {
    "id": "iX5i6bnL9TBp"
   },
   "outputs": [],
   "source": [
    "if DLIB_AVAILABLE:\n",
    "    detections, len(detections)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {
    "id": "9jlJ_ZE_-Dsa"
   },
   "outputs": [],
   "source": [
    "if DLIB_AVAILABLE:\n",
    "    for face in detections:\n",
    "      #print(face)\n",
    "      #print(face.left())\n",
    "      #print(face.top())\n",
    "      #print(face.right())\n",
    "      #print(face.bottom())\n",
    "      l, t, r, b = face.left(), face.top(), face.right(), face.bottom()\n",
    "      cv2.rectangle(image, (l, t), (r, b), (0, 255, 255), 2)\n",
    "    cv2_imshow(image)"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {
    "id": "xEep_Wldqzwg"
   },
   "source": [
    "### Detecting faces with CNN (Convolutional Neural Networks)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {
    "id": "HrP7vHgwBnlv"
   },
   "outputs": [],
   "source": [
    "cnn_model_path = DATA_DIR / \"Weights/mmod_human_face_detector.dat\"\n",
    "cnn_detector = None\n",
    "if not DLIB_AVAILABLE:\n",
    "    print(\"Skipping dlib CNN detection because dlib is not installed.\")\n",
    "elif not cnn_model_path.is_file():\n",
    "    print(f\"Skipping dlib CNN detection; model file not found: {cnn_model_path.resolve()}\")\n",
    "else:\n",
    "    image = load_image(DATA_DIR / \"Images/people2.jpg\")\n",
    "    cnn_detector = dlib.cnn_face_detection_model_v1(str(cnn_model_path))\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {
    "id": "uk6xM1RGCdR3"
   },
   "outputs": [],
   "source": [
    "if DLIB_AVAILABLE and cnn_detector is not None:\n",
    "    detections = cnn_detector(image, 1)\n",
    "    for face in detections:\n",
    "        l, t, r, b, c = face.rect.left(), face.rect.top(), face.rect.right(), face.rect.bottom(), face.confidence\n",
    "        print(c)\n",
    "        cv2.rectangle(image, (l, t), (r, b), (255, 255, 0), 2)\n",
    "    cv2_imshow(image)\n"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {
    "id": "6cwBNX6NuAlS"
   },
   "source": [
    "### Haarcascade x HOG x CNN"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {
    "id": "KSAy9oYQuTqR"
   },
   "source": [
    "#### Haarcascade"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {
    "id": "sILnjRbVEUj6"
   },
   "outputs": [],
   "source": [
    "image.shape"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {
    "id": "O2ZWDrQAuRZe"
   },
   "outputs": [],
   "source": [
    "image = load_image(DATA_DIR / \"Images/people3.jpg\")\n",
    "image_gray = cv2.cvtColor(image, cv2.COLOR_BGR2GRAY)\n",
    "haarcascade_detector = load_cascade(DATA_DIR / \"Cascades/haarcascade_frontalface_default.xml\")\n",
    "detections = haarcascade_detector.detectMultiScale(image_gray, scaleFactor = 1.001, minNeighbors=5, minSize = (5,5))\n",
    "for (x, y, w, h) in detections:\n",
    "  cv2.rectangle(image, (x, y), (x + w, y + h), (0,255,0), 2)\n",
    "cv2_imshow(image)"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {
    "id": "C6hDOscbvE_G"
   },
   "source": [
    "#### HOG"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {
    "id": "m3km17RuvGa0"
   },
   "outputs": [],
   "source": [
    "if DLIB_AVAILABLE:\n",
    "    image = load_image(DATA_DIR / \"Images/people3.jpg\")\n",
    "    face_detector_hog = dlib.get_frontal_face_detector()\n",
    "    detections = face_detector_hog(image, 4)\n",
    "    for face in detections:\n",
    "        l, t, r, b = (face.left(), face.top(), face.right(), face.bottom())\n",
    "        cv2.rectangle(image, (l, t), (r, b), (0, 255, 255), 2)\n",
    "    cv2_imshow(image)"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {
    "id": "9Oa6jANWv4Ik"
   },
   "source": [
    "#### CNN"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {
    "id": "TR4Uebotv5DV"
   },
   "outputs": [],
   "source": [
    "cnn_model_path = DATA_DIR / \"Weights/mmod_human_face_detector.dat\"\n",
    "if not DLIB_AVAILABLE:\n",
    "    print(\"Skipping dlib CNN detection because dlib is not installed.\")\n",
    "elif not cnn_model_path.is_file():\n",
    "    print(f\"Skipping dlib CNN detection; model file not found: {cnn_model_path.resolve()}\")\n",
